{
  "name": "coratella",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "pnpm test:unit --run && pnpm test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "drizzle:seed": "tsx --env-file-if-exists=.env ./src/lib/server/db/seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@skeletonlabs/skeleton": "^5.0.4",
    "@skeletonlabs/skeleton-svelte": "^5.0.4",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^3.2.1",
    "@lucide/svelte": "^1.70.0",
    "@node-rs/argon2": "^2.2.2",
    "color": "^5.0.3",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.17",
    "katex": "^0.16.27",
    "postgres": "^4.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-highlight": "^0.1.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.17.0"
}
